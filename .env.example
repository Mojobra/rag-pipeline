# Copy this file to .env and replace blank secrets before using those features.
# The CLI and API do not load .env automatically. Export the values in your shell
# or pass .env explicitly to a launcher that supports environment files.

# Required when starting the local HTTP API. Generate a random URL-safe token;
# see docs/API_REFERENCE.md. Never commit a populated .env file.
RAG_API_BEARER_TOKEN=

# Optional source-scoped HTTP queries (set both values together). The admin
# token above remains for /metrics; query callers use distinct random tokens.
# Policy v2 also needs `tenant` on each principal; tenant store paths and grants
# belong in the private policy JSON, not in HTTP requests.
# Store the policy under the ignored .rag_data/ directory; see docs/API_REFERENCE.md.
# RAG_API_PRINCIPALS_JSON={"principals":[{"id":"alice","token":"<random-query-token>","groups":["finance"]}]}
# RAG_API_ACCESS_POLICY_PATH=.rag_data/access-policy.json

# Optional HTTP API settings. Match the collection and embedding configuration
# used during CLI indexing; incompatible settings are rejected at query time.
# RAG_API_STORE_PATH=.rag_data/qdrant
# RAG_API_COLLECTION_NAME=rag_documents
# RAG_API_SEARCH_MODE=dense
# RAG_API_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_API_EMBEDDING_REVISION=
# RAG_API_SPARSE_MODEL=Qdrant/bm25
# RAG_API_GENERATION_MODEL=google/flan-t5-small
# RAG_API_GENERATION_REVISION=

# Optional manual SharePoint import (index-sharepoint). Supply all three values.
# RAG_SHAREPOINT_TENANT_ID=
# RAG_SHAREPOINT_CLIENT_ID=
# RAG_SHAREPOINT_CLIENT_SECRET=

# Optional manual Confluence Cloud import (index-confluence). Supply all three.
# RAG_CONFLUENCE_BASE_URL=https://your-site.atlassian.net
# RAG_CONFLUENCE_EMAIL=
# RAG_CONFLUENCE_API_TOKEN=

# Optional Google Drive import: path to a private ADC credential file.
# Omit this when using another Application Default Credentials source.
# GOOGLE_APPLICATION_CREDENTIALS=

# Optional manual Slack channel import (index-slack). Use a bot token with
# channel history scope and channel membership; never commit a populated .env.
# RAG_SLACK_BOT_TOKEN=

# Optional manual Teams channel import (index-teams). Supply all three values.
# RAG_TEAMS_TENANT_ID=
# RAG_TEAMS_CLIENT_ID=
# RAG_TEAMS_CLIENT_SECRET=
